<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
         version="6.1">

    <display-name>ShopSphere</display-name>

    <!-- ServletContext init parameters (application-wide configuration) -->
    <context-param>
        <param-name>appName</param-name>
        <param-value>ShopSphere</param-value>
    </context-param>
    <context-param>
        <param-name>supportEmail</param-name>
        <param-value>support@shopsphere.com</param-value>
    </context-param>

    <!-- Filters: declared here so their order is guaranteed -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.shopsphere.web.filter.EncodingFilter</filter-class>
    </filter>
    <filter>
        <filter-name>LocaleFilter</filter-name>
        <filter-class>com.shopsphere.web.filter.LocaleFilter</filter-class>
    </filter>
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.shopsphere.web.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter>
        <filter-name>AdminFilter</filter-name>
        <filter-class>com.shopsphere.web.filter.AdminFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>LocaleFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/cart</url-pattern>
        <url-pattern>/checkout</url-pattern>
        <url-pattern>/orders</url-pattern>
        <url-pattern>/order</url-pattern>
        <url-pattern>/order-success</url-pattern>
        <url-pattern>/wishlist</url-pattern>
        <url-pattern>/profile</url-pattern>
        <url-pattern>/review</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- Servlet configured in XML to demonstrate ServletConfig init-params and load-on-startup -->
    <servlet>
        <servlet-name>LifecycleServlet</servlet-name>
        <servlet-class>com.shopsphere.web.controller.demo.LifecycleServlet</servlet-class>
        <init-param>
            <param-name>welcomeMessage</param-name>
            <param-value>Hello from ServletConfig!</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>LifecycleServlet</servlet-name>
        <url-pattern>/demo/lifecycle</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Every JSP is UTF-8 and automatically gets the taglib/i18n prelude -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <include-prelude>/WEB-INF/views/fragments/taglibs.jsp</include-prelude>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
            <default-content-type>text/html;charset=UTF-8</default-content-type>
        </jsp-property-group>
    </jsp-config>

    <!-- JNDI environment entry read by the JNDI demo -->
    <env-entry>
        <env-entry-name>appVersion</env-entry-name>
        <env-entry-type>java.lang.String</env-entry-type>
        <env-entry-value>1.0</env-entry-value>
    </env-entry>

    <!-- JNDI DataSource defined in META-INF/context.xml -->
    <resource-ref>
        <res-ref-name>jdbc/ShopSphereDB</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error.jsp</location>
    </error-page>
</web-app>
