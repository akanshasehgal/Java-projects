<%@ taglib prefix="x" uri="jakarta.tags.xml" %>
<c:set var="pageTitle" value="JSTL XML"/>
<%@ include file="/WEB-INF/views/fragments/header.jsp" %>

<h1 class="h4 fw-bold">JSTL XML tags</h1>
<p class="text-muted">This page imports the live XML feed generated by <code class="demo">ProductFeedServlet</code>
    (<a href="${ctx}/demo/feed.xml">/demo/feed.xml</a>) and reads it with XPath.</p>

<c:catch var="xmlError">
    <c:import url="/demo/feed.xml" var="feed"/>
    <x:parse doc="${feed}" var="doc"/>

    <p>Store: <strong><x:out select="$doc/products/@store"/></strong> &middot;
        Products in feed: <strong><x:out select="count($doc/products/product)"/></strong></p>

    <div class="bg-white rounded-3 shadow-sm table-responsive">
        <table class="table mb-0">
            <thead class="table-light"><tr><th>ID</th><th>Name</th><th>Brand</th><th>Category</th><th class="text-end">Price</th><th>Stock</th></tr></thead>
            <tbody>
            <x:forEach select="$doc/products/product" var="p">
                <tr>
                    <td><x:out select="$p/@id"/></td>
                    <td><x:out select="$p/name"/></td>
                    <td><x:out select="$p/brand"/></td>
                    <td><x:out select="$p/category"/></td>
                    <td class="text-end">&#8377;<x:out select="$p/price"/></td>
                    <td>
                        <x:choose>
                            <x:when select="$p/@inStock = 'true'"><span class="badge text-bg-success">In stock</span></x:when>
                            <x:otherwise><span class="badge text-bg-danger">Out of stock</span></x:otherwise>
                        </x:choose>
                        <x:if select="$p/discount >= 30"><span class="badge text-bg-warning">Big deal</span></x:if>
                    </td>
                </tr>
            </x:forEach>
            </tbody>
        </table>
    </div>
</c:catch>
<c:if test="${not empty xmlError}">
    <div class="alert alert-danger">Could not read the XML feed: <c:out value="${xmlError.message}"/></div>
</c:if>

<%@ include file="/WEB-INF/views/fragments/footer.jsp" %>
